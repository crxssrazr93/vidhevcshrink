# vidhevcshrink settings. Copy to .env and edit. .env is ignored by git, so private values stay local.
# This file is sourced by bash: no spaces around =, and quote values that contain spaces.

# --- Required -------------------------------------------------------------
# The GPU box, as you would type it for ssh. Key login must work without a password prompt.
REMOTE_HOST=user@192.168.1.50

# --- Where things live ----------------------------------------------------
# Job folders on the GPU box, relative to its home folder. Created on first use.
REMOTE_JOBS_DIR=vidhevcshrink/jobs
# Local state (queue, done list, log, job files). Default: ./state inside this folder.
#STATE_DIR=~/.local/share/vidhevcshrink
# Optional: the folder your videos live in. The monitor shortens paths under it and shows its free space.
#MEDIA_ROOT=/mnt/videos

# --- Encoding -------------------------------------------------------------
# HEVC NVENC constant quality. Lower is better quality and bigger files. 33 measured VMAF 93 to 96 on screen recordings.
CQ=33
# NVENC preset, p1 (fastest) to p7 (slowest).
PRESET=p5
# Source video codecs to shrink, space separated. Anything else is skipped untouched.
SOURCE_CODECS=h264
# Audio is copied when already at or under these bitrates (plus 16k), otherwise re-encoded to AAC at them.
AUDIO_MONO_BITRATE=64000
AUDIO_STEREO_BITRATE=96000

# --- Deciding whether a file is worth it ---------------------------------
# Files longer than SAMPLE_MIN_DURATION seconds get a SAMPLE_SECONDS test encode from the middle first;
# the file is skipped if that sample saves less than MIN_GAIN_PCT percent.
SAMPLE_MIN_DURATION=180
SAMPLE_SECONDS=60
MIN_GAIN_PCT=25
# The result must match the original's duration within this many seconds, or the original is kept.
DURATION_TOLERANCE=2

# --- Throughput and box disk ----------------------------------------------
# Encoders running at once. On one NVENC chip more encoders do not add throughput; 2 removes idle gaps between files.
ENCODERS=2
# Files uploaded and waiting for a free encoder.
READY_MAX=2
# Never hold more than this on the box, and never upload if the box would drop under the free minimum.
REMOTE_JOBS_MAX_GB=30
REMOTE_FREE_MIN_GB=40
